<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS SPA fallback: rewrites any request that isn't an existing file/directory to index.html, so
  React Router's client-side routes (e.g. a deep link to /predictions or a page refresh) don't 404.
  Requests under /api are excluded so they reach the API application instead of being rewritten.
  Requires the IIS URL Rewrite Module (not installed by default - a separate download).

  There is deliberately NO "app offline" rewrite rule here. An earlier version had one, matching on
  the presence of app_offline.htm, and it was unreliable in a way that took a long time to pin down:
  IIS caches the response for "/" and invalidates that cache when the file it actually served
  (index.html) changes - it has no idea a rewrite rule's condition depends on a different, unwatched
  file. So adding or removing app_offline.htm left "/" serving a stale answer while every other URL
  was correct, in both directions: sometimes the live app during an outage, sometimes a cached
  rewrite to an app_offline.htm that the deploy had already deleted - which is a 404 (0x80070002)
  from the static file handler, on the site's root URL, persisting after deployment.

  Measured: changing app_offline.htm left "/" stale for 5+ seconds (indefinitely in the field);
  changing index.html was reflected at "/" instantly. So the offline state is now a property of
  index.html itself - Deployment/Publish-Local.ps1 overwrites index.html with the offline page for
  the duration of the upgrade and the build output restores it. That rides IIS's one reliable
  invalidation path instead of fighting it. See README.md's "Taking the site offline" section.
-->
<configuration>
  <system.webServer>
    <!-- Declared explicitly rather than inherited from IIS Manager / applicationHost.config state
         that isn't tracked in this repo. "/" maps to a real directory, so the SPA-fallback rule
         below (which requires a non-directory target) never matches it - default document
         resolution is what turns "/" into index.html. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <!--
          The legacy ASP.NET Web Forms app (the deleted UI/Web project) served ~32 .aspx pages
          under /Pages/... plus /Login.aspx, and two .ashx handlers. Old inbound links to those
          still arrive. Without this rule they'd fall through to the SPA fallback below: HTTP 200
          serving index.html, then React Router's catch-all doing a client-side redirect to "/".
          That lands the visitor in the right place, but only after downloading and booting the
          whole React bundle purely to bounce - and to a crawler it reads as a live page rather
          than a moved one, with ?MatchID=1, ?MatchID=2 ... each looking like a distinct URL
          returning identical content.

          A 301 here settles both: one round trip for the visitor, and an unambiguous "moved
          permanently" that consolidates the old URLs onto the home page.

          appendQueryString="false" is load-bearing. URL Rewrite appends the original query string
          to the target by default, which would send /Pages/Match/MatchDetail.aspx?MatchID=xxx to
          /?MatchID=xxx - recreating exactly the per-match duplicate home-page URLs this is meant
          to remove.

          Must stay above the SPA fallback rule: rules run in order and that one stopProcessing's.
        -->
        <rule name="Legacy ASPX/ASHX to home" stopProcessing="true">
          <match url="\.(aspx|ashx)$" />
          <action type="Redirect" url="/" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>

  <!-- index.html has no explicit Cache-Control by default, which leaves room for ordinary browser
       heuristic caching to hold onto a stale copy - and it is now also the file that carries the
       offline page during an upgrade, so a browser holding a stale copy is exactly how a visitor
       gets stuck on the offline page after the site is back. Unlike the hashed /assets/* URLs
       (whose hash is their cache key, so they are safe to cache forever), this one must always be
       revalidated. Location-based config resolves against the post-rewrite path, so this covers
       every deep-link route the SPA-fallback rule rewrites to index.html, not just literal
       "/index.html" requests. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
