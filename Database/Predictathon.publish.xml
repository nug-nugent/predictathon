<?xml version="1.0" encoding="utf-8"?>
<!--
Publish profile for scripting/publishing against the real production database. Deliberately
has no TargetConnectionString/TargetServerName/TargetDatabaseName - those stay command-line-only
(via /TargetConnectionString:) so credentials never end up in a file that gets committed.

Usage:
  sqlpackage /Action:Publish /SourceFile:"Database\bin\Release\net10.0\Predictathon.Database.dacpac" /TargetConnectionString:"..." /Profile:"Database\Predictathon.publish.xml" /p:ExcludeObjectTypes="Users;RoleMembership;DatabaseRoles;Permissions"

  Also used by .github/workflows/deploy.yml, which runs this automatically as part of the
  production deploy (see README.md's "Database schema" section).
-->
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <IncludeCompositeObjects>True</IncludeCompositeObjects>
    <ProfileVersionNumber>1</ProfileVersionNumber>
    <!-- False so the diff can drop a column that still holds data - it can't otherwise, and a
         pre-deployment workaround doesn't help: the deployment plan is generated before
         pre-deployment scripts run, so the plan still contains the DROP and then fails on the
         already-dropped column. Turned off when MessageReaction.ImageUrl was retired.

         Note this pairs with DropObjectsNotInSource below: together they mean a table definition
         accidentally deleted from this project is dropped, with its data, on the next deploy
         rather than blocking. The deploy workflow's `sqlpackage /Action:Script` step (which runs
         before /Action:Publish) is what's left to catch that - it writes the generated plan out,
         so review it whenever a deploy touches a table you didn't intend to change. -->
    <BlockOnPossibleDataLoss>False</BlockOnPossibleDataLoss>
    <DropObjectsNotInSource>True</DropObjectsNotInSource>
    <!-- Users/RoleMembership/DatabaseRoles/Permissions are SQL Server's own database
         principals and role grants - not modelled here, provisioned by the host outside this
         project, and not safe for a schema diff to touch (could drop the very login the
         script is connecting as). The predicta_dbuser default schema Plesk auto-created
         alongside the login was a similar case, but has since been dropped from production
         directly rather than excluded here - a schema has no environment-specific content, so
         it's safe (and correct) to let the diff manage it normally rather than blind it to
         schema changes generally. -->
    <ExcludeObjectTypes>Users;RoleMembership;DatabaseRoles;Permissions</ExcludeObjectTypes>
  </PropertyGroup>
</Project>
