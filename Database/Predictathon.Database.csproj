<Project Sdk="MSBuild.Sdk.SqlProj/4.3.0">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<SqlServerVersion>Sql150</SqlServerVersion>
		<!-- Declares the compatibility level every environment is expected to run at. STRING_AGG and
		     friends gate on this rather than on the engine version, so a database left at an older
		     level rejects syntax the server itself supports - which is exactly how UserTrophiesGet
		     failed to deploy against a SQL 2019 instance still sitting at level 100. SqlPackage only
		     acts on this when a publish passes /p:ScriptDatabaseCompatibility=True (it defaults to
		     False, so the production profile leaves the live setting well alone); Database/
		     Dockerfile.migrate opts in, so the dev stack cannot drift ahead of production and hide
		     a compatibility-gated bug the way it did that time. -->
		<CompatibilityLevel>150</CompatibilityLevel>
		<RunSqlCodeAnalysis>True</RunSqlCodeAnalysis>
		<!-- For additional properties that can be set here, please refer to https://github.com/rr-wfm/MSBuild.Sdk.SqlProj#model-properties -->
		<!-- ...and https://learn.microsoft.com/en-gb/dotnet/api/microsoft.sqlserver.dac.model.tsqlmodeloptions?view=sql-dacfx-162 -->
		<RecoveryMode>Simple</RecoveryMode>
		<!-- Rules disabled project-wide (not just for one file) because they flag deliberate design
		     choices rather than defects: SRD0003 - every table uses a GUID surrogate PK by design;
		     SRD0001 - surrogate-key-only tables (claims/log/junction tables) are expected to lack a
		     natural key; SRD0010 - identity seed >= 1000 is a house-style preference with no value on
		     this small, already-live database; SRN0007 - naming-standard nitpicks (half of it fires on
		     ASP.NET Identity's own scaffolded names, the rest wants live FK constraints renamed for no
		     functional benefit); SRD0047 - "same-named column, different type" is inherent noise for a
		     schema with generic column names like Id/Name/CreatedAtUtc; SRD0032/SRP0024/SRP0009/SR0006 -
		     sargability/correlated-subquery/table-scan performance heuristics that aren't worth chasing
		     on a ~50-user hobby app; SRD0028 - the rule's AST walk can't tell a real unqualified table
		     column from an ORDER BY reference to a SELECT-list alias (e.g. "ORDER BY LeaguePosition"
		     referencing "LeaguePosition = ROW_NUMBER() OVER (...)"), and every instance in this codebase
		     is the latter - there's no table to prefix an alias with, so "fixing" it means repeating the
		     whole expression in the ORDER BY instead of the alias, which is worse; SRD0043 - compares
		     ISNULL/COALESCE argument types via two different code paths (schema-resolved for a plain
		     column, AST-literal-derived for a CAST/literal), so it flags "int" vs "int" as a mismatch
		     purely from string-formatting differences between those paths - checked every instance,
		     all are genuinely same-typed; SR0007/SR0014 - Microsoft's built-in nullable-predicate and
		     narrowing-cast heuristics fire on every nullable comparison/cast regardless of intent;
		     checked every instance here and the NULL-propagation/truncation is the desired behaviour
		     (e.g. CAST(x AS DATE) to compare date-only) not an accident; SML006 - same "explicit cast
		     on a column" shape as the SRP0009 sargability warnings above, same reasoning. Use
		     StaticCodeAnalysis.SuppressMessages.xml instead for suppressions scoped to a single file. -->
		<CodeAnalysisRules>-SqlServer.Rules.SRD0003;-SqlServer.Rules.SRD0001;-SqlServer.Rules.SRD0010;-SqlServer.Rules.SRN0007;-SqlServer.Rules.SRD0047;-SqlServer.Rules.SRD0032;-SqlServer.Rules.SRP0024;-SqlServer.Rules.SRP0009;-Microsoft.Rules.Data.SR0006;-SqlServer.Rules.SRD0028;-SqlServer.Rules.SRD0043;-Microsoft.Rules.Data.SR0007;-Microsoft.Rules.Data.SR0014;-Smells.SML006</CodeAnalysisRules>

	</PropertyGroup>

	<ItemGroup>
		<!-- These packages adds additional code analysis rules -->
		<!-- We recommend using these, but they can be removed if desired -->
		<PackageReference Include="ErikEJ.DacFX.SqlServer.Rules" Version="3.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="ErikEJ.DacFX.TSQLSmellSCA" Version="3.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<PropertyGroup>
		<!-- Refer to https://github.com/rr-wfm/MSBuild.Sdk.SqlProj#publishing-support for supported publishing options -->
	</PropertyGroup>

	<ItemGroup>
		<PreDeploy Include="Pre-Deployment\Script.PreDeployment.sql" />
		<PostDeploy Include="Post-Deployment\Script.PostDeployment.sql" />
	</ItemGroup>

	<ItemGroup>
		<!-- sp_generate_merge (vendored utility, see StaticCodeAnalysis.SuppressMessages.xml) references
		     sys.* catalog views in ways the static schema model can't resolve unambiguously. Scoped to
		     just this file so the warning still fires if our own code ever hits it. -->
		<Content Update="dbo\Stored Procedures\sp_generate_merge.sql">
			<SuppressTSqlWarnings>71502</SuppressTSqlWarnings>
		</Content>
	</ItemGroup>
</Project>
