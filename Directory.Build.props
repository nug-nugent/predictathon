<Project>
  <!-- Single source of truth for the application version, shared by every project in the
       solution (drives AssemblyVersion/FileVersion/InformationalVersion automatically).
       Patch-bumped automatically on every production deploy (see the "Bump version and tag"
       step in .github/workflows/deploy.yml), kept in sync with frontend/package.json's
       "version" there - the two aren't wired together mechanically since they're separate
       build systems, so if you ever hand-edit one for a deliberate minor/major bump, edit the
       other to match in the same PR. -->
  <PropertyGroup>
    <Version>2.1.2</Version>
  </PropertyGroup>
</Project>
