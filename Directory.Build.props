<Project>
  <!-- Single source of truth for the application version, shared by every project in the
       solution (drives AssemblyVersion/FileVersion/InformationalVersion automatically). Bump
       alongside frontend/package.json's "version" when cutting a release - the two aren't wired
       together mechanically since they're separate build systems, so keep them in sync by hand. -->
  <PropertyGroup>
    <Version>2.0.0</Version>
  </PropertyGroup>
</Project>
