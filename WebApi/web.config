<?xml version="1.0" encoding="utf-8"?>
<!--
  dotnet publish merges its auto-generated <aspNetCore> element into this file rather than
  overwriting it, so anything added here (like the WebDAV removal below) survives every future
  publish - see README.md's "Production deployment" section.
-->
<configuration>
  <system.webServer>
    <!--
      IIS's WebDAV module intercepts PUT/DELETE/PATCH requests before they reach ASP.NET Core,
      returning 405 Method Not Allowed - it has no equivalent in Kestrel-only dev, so this only
      surfaces once hosted on IIS. Every ICrudService-backed edit endpoint uses [HttpPut], so
      without this removal, editing anything (competitions, matches, announcements, users, etc.)
      405s in production while working fine locally.
    -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
  </system.webServer>
</configuration>
