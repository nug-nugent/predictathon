<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ecbe63d7-5807-4d6a-9363-ee2ef7df13f5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Predictathon.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\Predictathon.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\Base\" />
  </ItemGroup>

  <!-- Vendored reaction images (standard-emoji SVGs + Predictathon's custom reactions) - static,
       checked into source control, served via the /reactions static-files mapping in Program.cs.
       Not under wwwroot, so needs an explicit copy-to-output rule for a real publish. -->
  <ItemGroup>
    <!-- Remove first: the SDK's default Content globs already pick up custom-reactions.json (any
         .json under the project directory), which would collide with the explicit include below. -->
    <Content Remove="Assets\Reactions\**" />
    <Content Include="Assets\Reactions\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
