{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/predictathon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "restrictedToMinimumLevel": "Warning",
          "sinkOptions": {
            "tableName": "ErrorLog",
            "autoCreateSqlTable": false
          },
          "columnOptionsSection": {
            "timeStamp": {
              "columnName": "TimeStampUtc",
              "convertToUtc": true
            }
          }
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Predictathon",
    "Audience": "Predictathon"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Avatars": {
    "StoragePath": "Uploads/Avatars"
  },
  "MessageImages": {
    "StoragePath": "Uploads/MessageImages"
  },
  "Frontend": {
    "BaseUrl": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "FromAddress": "noreply@predictathon.co.uk",
    "FromName": "Predictathon"
  },
  "PayPal": {
    "Mode": "sandbox",
    "ClientId": "",
    "ClientSecret": ""
  },
  "FootballDataApi": {
    "ApiKey": ""
  },
  "ScheduledTasks": {
    "ApiKey": ""
  },
  "Health": {
    "ApiKey": "",
    "DetailedApiKey": ""
  }
}
