{
  "Cors": {
    "AllowedOrigins": [ "https://predictathon.dev.localhost" ]
  },
  "Frontend": {
    "BaseUrl": "https://predictathon.dev.localhost"
  },
  "Avatars": {
    "StoragePath": "..\\Data\\Uploads\\Avatars",
    "PublicBaseUrl": "https://predictathon.dev.localhost/api"
  },
  "MessageImages": {
    "StoragePath": "..\\Data\\Uploads\\MessageImages",
    "PublicBaseUrl": "https://predictathon.dev.localhost/api"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "..\\Data\\Logs\\predictathon-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
